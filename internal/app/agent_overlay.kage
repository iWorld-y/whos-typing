// 动态点阵遮罩，使用 MyGo 的 Go 语法着色器。
package main

var Time float
var Opacity float
var Pointer vec2
var PointerAge float

func random(p vec2) float {
	return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453)
}

func noise(p vec2) float {
	cell := floor(p)
	f := fract(p)
	f = f * f * (3.0 - 2.0*f)
	a := mix(random(cell), random(cell + vec2(1, 0)), f.x)
	b := mix(random(cell + vec2(0, 1)), random(cell + vec2(1, 1)), f.x)
	return mix(a, b, f.y)
}

func field(p vec2) float {
	return 0.57*noise(p) + 0.28*noise(p*2.1) + 0.15*noise(p*4.2)
}

func Fragment(dst vec4, pos vec2) vec4 {
	size := max(rectSize(), vec2(1))
	cell := floor(pos / 6.0)
	center := (cell + vec2(0.5)) * 6.0
	uv := center / size
	flow := field(uv*4.2 + vec2(Time*0.10, Time*0.07))
	wavePos := (uv - vec2(0.54, 0.36)) * vec2(size.x/size.y, 1)
	wave := 0.5 + 0.5*sin(length(wavePos)*22.0 - Time*2.0)
	glow := exp(-distance(center, Pointer)*distance(center, Pointer)/8500.0) * exp(-max(PointerAge, 0.0)*1.3)
	brightness := clamp(0.68*flow + 0.24*wave + 0.7*glow, 0.0, 1.0)

	// 同一个网格包含柔和点和按随机阈值闪烁的亮点。
	inCell := abs(pos - center)
	dotMask := step(max(inCell.x, inCell.y), 0.7)
	soft := smoothstep(0.32, 0.78, brightness) * dotMask
	spark := step(random(cell + vec2(13.7, 4.1)), brightness*0.7) * dotMask
	dotAlpha := clamp(soft*0.45 + spark*0.38, 0.0, 0.75) * Opacity
	washAlpha := 0.05 * Opacity
	wash := vec3(0.54, 0.60, 0.72)
	dotColor := vec3(0.98, 0.99, 1.0)
	alpha := washAlpha
	color := wash*washAlpha

	// 宽光晕由边缘向内衰减，并用变化的亮度形成流动的蓝色光带。
	halfSize := max(size*0.5 - vec2(1), vec2(1))
	radius := min(16.0, min(halfSize.x, halfSize.y))
	q := abs(pos - size*0.5) - (halfSize - vec2(radius))
	borderDistance := length(max(q, vec2(0))) + min(max(q.x, q.y), 0.0) - radius
	width := clamp(min(size.x, size.y)*0.18, 70.0, 130.0)
	halo := exp(-pow(max(-borderDistance, 0.0)/width, 1.6))
	sweep := 0.5 + 0.5*cos((pos.y/size.y-Time*0.12)*6.2831853)
	variation := field(uv*vec2(2.0, 3.0) + vec2(-Time*0.08, Time*0.12))
	edgeAlpha := clamp(halo*(0.25+0.32*sweep)*(0.65+0.6*variation), 0.0, 0.65) * Opacity
	color = vec3(0.18, 0.48, 0.98)*edgeAlpha + color*(1.0-edgeAlpha)
	alpha = edgeAlpha + alpha*(1.0-edgeAlpha)
	color = dotColor*dotAlpha + color*(1.0-dotAlpha)
	alpha = dotAlpha + alpha*(1.0-dotAlpha)
	return vec4(color, alpha)
}
